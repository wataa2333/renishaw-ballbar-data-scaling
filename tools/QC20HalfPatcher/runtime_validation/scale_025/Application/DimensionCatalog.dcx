<?xml version="1.0" encoding="utf-8"?>
<!-- 
  DimensionCatalog.xml
  
  This file defines dimensions and their units. Each dimension must contain a primary unit, all measurements 
  created in this dimension will store their quantity internally in this primary unit.
  Each of the other units in the dimension utilise a UnitConverter this contains the equation that calculates 
  the primary quantity. e.g. The Linear conversion y = mx + c is for converting the quantity TO primary units
  for that dimension.
-->
<!DOCTYPE xsl:DimensionCatalog[
    <!ENTITY deg "&#176;">
    <!ENTITY micro "&#181;">
]>

<DimensionCatalog xmlns="http://tempuri.org/XMLSchema.xsd">
    <Dimensions>

        <Dimension Name="UT_LENGTH">
            <Units>
                <Unit Name="metres">
                    <Symbol>m</Symbol>
                    <ShortName>metric</ShortName>
                    <DefaultPrecision>6</DefaultPrecision>
                    <UnitConverter type="Renishaw.Calibration.UnitService.LinearUnitConverterBuilder" >
                        <ParamCount>2</ParamCount>
                        <Param>
                            <Name>gradient</Name>
                            <Value type="double">1.0</Value>
                        </Param>
                        <Param>
                            <Name>intercept</Name>
                            <Value type="double">0.0</Value>
                        </Param>
                    </UnitConverter>
                </Unit>
                <Unit Name="alignmentMillimetres">
                    <Symbol>mm</Symbol>
                    <ShortName>metric</ShortName>
                    <DefaultPrecision>2</DefaultPrecision>
                    <UnitConverter type="Renishaw.Calibration.UnitService.LinearUnitConverterBuilder" >
                        <ParamCount>2</ParamCount>
                        <Param>
                            <Name>gradient</Name>
                            <Value type="double">0.001</Value>
                        </Param>
                        <Param>
                            <Name>intercept</Name>
                            <Value type="double">0.0</Value>
                        </Param>
                    </UnitConverter>
                </Unit>
                <Unit Name="millimetres">
                    <Symbol>mm</Symbol>
                    <ShortName>metric</ShortName>
                    <DefaultPrecision>4</DefaultPrecision>
                    <UnitConverter type="Renishaw.Calibration.UnitService.LinearUnitConverterBuilder" >
                        <ParamCount>2</ParamCount>
                        <Param>
                            <Name>gradient</Name>
                            <Value type="double">0.001</Value>
                        </Param>
                        <Param>
                            <Name>intercept</Name>
                            <Value type="double">0.0</Value>
                        </Param>
                    </UnitConverter>
                </Unit>
                <Unit Name="micrometres">
                    <Symbol>
                        &micro;m
                    </Symbol>
                    <ShortName>metric</ShortName>
                    <DefaultPrecision>1</DefaultPrecision>
                    <UnitConverter type="Renishaw.Calibration.UnitService.LinearUnitConverterBuilder" >
                        <ParamCount>2</ParamCount>
                        <Param>
                            <Name>gradient</Name>
                            <Value type="double">0.000001</Value>
                        </Param>
                        <Param>
                            <Name>intercept</Name>
                            <Value type="double">0.0</Value>
                        </Param>
                    </UnitConverter>
                </Unit>
                <Unit Name="inches">
                    <Symbol>in</Symbol>
                    <ShortName>english</ShortName>
                    <DefaultPrecision>6</DefaultPrecision>
                    <UnitConverter type="Renishaw.Calibration.UnitService.LinearUnitConverterBuilder" >
                        <ParamCount>2</ParamCount>
                        <Param>
                            <Name>gradient</Name>
                            <Value type="double">0.0254</Value>
                        </Param>
                        <Param>
                            <Name>intercept</Name>
                            <Value type="double">0.0</Value>
                        </Param>
                    </UnitConverter>
                </Unit>
                <Unit Name="thou">
                    <Symbol>thou</Symbol>
                    <ShortName>english</ShortName>
                    <DefaultPrecision>4</DefaultPrecision>
                    <UnitConverter type="Renishaw.Calibration.UnitService.LinearUnitConverterBuilder" >
                        <ParamCount>2</ParamCount>
                        <Param>
                            <Name>gradient</Name>
                            <Value type="double">0.0000254</Value>
                        </Param>
                        <Param>
                            <Name>intercept</Name>
                            <Value type="double">0.0</Value>
                        </Param>
                    </UnitConverter>
                </Unit>
                <Unit Name="alignmentInches">
                    <Symbol>in</Symbol>
                    <ShortName>english</ShortName>
                    <DefaultPrecision>4</DefaultPrecision>
                    <UnitConverter type="Renishaw.Calibration.UnitService.LinearUnitConverterBuilder" >
                        <ParamCount>2</ParamCount>
                        <Param>
                            <Name>gradient</Name>
                            <Value type="double">0.0254</Value>
                        </Param>
                        <Param>
                            <Name>intercept</Name>
                            <Value type="double">0.0</Value>
                        </Param>
                    </UnitConverter>
                </Unit>
                <Unit Name="micro-inches">
                    <Symbol>&micro;in</Symbol>
                    <ShortName>english</ShortName>
                    <DefaultPrecision>2</DefaultPrecision>
                    <UnitConverter type="Renishaw.Calibration.UnitService.LinearUnitConverterBuilder" >
                        <ParamCount>2</ParamCount>
                        <Param>
                            <Name>gradient</Name>
                            <Value type="double">0.0000000254</Value>
                        </Param>
                        <Param>
                            <Name>intercept</Name>
                            <Value type="double">0.0</Value>
                        </Param>
                    </UnitConverter>
                </Unit>
                <Unit Name="feet">
                    <Symbol>ft</Symbol>
                    <ShortName>english</ShortName>
                    <DefaultPrecision>6</DefaultPrecision>
                    <UnitConverter type="Renishaw.Calibration.UnitService.LinearUnitConverterBuilder" >
                        <ParamCount>2</ParamCount>
                        <Param>
                            <Name>gradient</Name>
                            <Value type="double">0.3048</Value>
                        </Param>
                        <Param>
                            <Name>intercept</Name>
                            <Value type="double">0.0</Value>
                        </Param>
                    </UnitConverter>
                </Unit>
